{
  "name": "togglepulse",
  "version": "1.0.0",
  "description": "Feature flag service with kill switches, percentage rollouts and targeting rules",
  "private": true,
  "homepage": "https://taan1el.github.io/togglepulse/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taan1el/togglepulse.git"
  },
  "bugs": {
    "url": "https://github.com/Taan1el/togglepulse/issues"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "npm run lint --workspace=server",
    "lint:client": "npm run lint --workspace=client",
    "build:pages": "npm run build:pages --workspace=client"
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "canary-rollout",
    "percentage-rollout",
    "targeting-rules",
    "kill-switch",
    "react19",
    "sqlite-wal"
  ],
  "author": "Taaniel Vananurm",
  "license": "MIT"
}
